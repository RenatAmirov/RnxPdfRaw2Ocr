<Window
    x:Class="RnxPdfRaw2Ocr.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="PDF OCR">
    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="600" Padding="32,28,32,28" Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock Text="PDF OCR" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Добавьте поиск и выделение текста в скан PDF."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="14" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Исходный PDF" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SourceText" Text="Файл не выбран" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="SelectButton" Content="Выбрать PDF" Click="SelectPdf_Click" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="LanguageBox" Header="Язык текста" SelectedIndex="0">
                        <ComboBoxItem Content="Русский и английский" Tag="rus+eng" />
                        <ComboBoxItem Content="Русский" Tag="rus" />
                        <ComboBoxItem Content="Английский" Tag="eng" />
                    </ComboBox>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartButton" Content="Распознать и сохранить…" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                <Button x:Name="CancelButton" Content="Отменить" Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Spacing="7" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="ProgressBar" AutomationProperties.Name="Ход распознавания" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenButton" Content="Открыть PDF" Visibility="Collapsed" Click="OpenResult_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</Window>
